{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kieransimkin/ByteFables/blob/main/docs/specs/manifest-v1.schema.json",
  "title": "ByteFables format manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "formats"],
  "properties": {
    "schema": {"const": "bytefables-format-manifest-1"},
    "formats": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/format"}}
  },
  "$defs": {
    "format": {
      "type": "object", "additionalProperties": false,
      "required": ["formatId", "version", "category", "maturity", "guarantee", "input",
        "sensitivity", "reference", "standardStatus", "license", "referenceVectors", "decoder",
        "minInputBytes", "maxInputBytes", "maxOutputBytes", "capacity", "estimatedExpansion",
        "mediaTypes", "carriers", "integrity", "errorCorrection", "deterministic", "offlineSafe",
        "runtime", "adapter"],
      "properties": {
        "formatId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)+$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "category": {"enum": ["codec", "identity", "symbol", "scene", "exporter", "archive", "watermark"]},
        "maturity": {"enum": ["foundation", "experimental", "planned"]},
        "guarantee": {"enum": ["reversible-raw", "reversible-typed", "identity-only", "presentation-only", "probabilistic-recovery"]},
        "input": {"enum": ["public-record", "module-matrix", "vector-scene", "public-record-and-carrier"]},
        "sensitivity": {"const": "public-only"},
        "reference": {"type": "string", "pattern": "^https://"},
        "standardStatus": {"enum": ["published", "draft", "internal", "research"]},
        "license": {"type": "string", "minLength": 1},
        "referenceVectors": {"type": ["string", "null"]},
        "decoder": {"type": ["string", "null"]},
        "minInputBytes": {"type": "integer", "minimum": 0},
        "maxInputBytes": {"type": "integer", "minimum": 0},
        "maxOutputBytes": {"type": "integer", "minimum": 0},
        "capacity": {"enum": ["byte-exact", "digest-prefix", "visual-bounded", "symbol-defined", "story-13", "story-variable", "carrier-dependent"]},
        "estimatedExpansion": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "mediaTypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "carriers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "integrity": {"enum": ["none", "crc32-accidental", "sha256-unkeyed", "format-specific"]},
        "errorCorrection": {"enum": ["none", "format-specific"]},
        "deterministic": {"type": "boolean"},
        "offlineSafe": {"type": "boolean"},
        "runtime": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["node", "browser"]}},
        "adapter": {"type": ["string", "null"]}
      }
    }
  }
}
