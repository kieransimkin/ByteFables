+      - 'scripts/tool_approval_s11.py'
+      - 'tests/unit/test_tool_stage_s10.py'
+      - 'tests/unit/test_ui_tool_upgrades_s11.py'
+      - 'tests/unit/test_tool_upgrade_approval_store_s11.py'
