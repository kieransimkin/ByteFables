+          version: '0.12.23'
+      - name: Install source-locked Python environment
+        run: uv sync --locked --extra web --dev
+      - name: Offline S10 and S11 unit acceptance
+        run: >-
+          uv run --locked python -m pytest -q
+          tests/unit/test_tool_stage_s10.py
+          tests/unit/test_ui_tool_upgrades_s11.py
+          tests/unit/test_tool_upgrade_approval_store_s11.py
+          tests/unit/test_tool_approval_worker_s11.py
+      - name: Check syntax and source style
+        run: uv run --locked ruff check src/potbot/tools/tool_stage_s10.py src/potbot/tools/tool_approval_worker_s11.py src/potbot/api/ui_tool_upgrades.py src/potbot/persistence/tool_upgrade_approval_schema.py scripts/tool_pipeline_s10.py scripts/tool_approval_s11.py
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+      - name: Node public and route contracts
+        working-directory: frontend
+        run: node --experimental-strip-types --test tests/tool-upgrades.test.mjs tests/tool-upgrades-routes.test.mjs
+      - name: Full frontend typecheck and build
+        working-directory: frontend
+        run: |
+          npm ci --ignore-scripts --no-audit --no-fund
+          npm run typecheck
+          npm run build
