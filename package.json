{
  "name": "bytefables",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic public identities and experimental reversible binary stories for the DanceFlow ecosystem",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "manifests",
    "docs/specs",
    "README.md",
    "LICENSE",
    "src/grammar/wordlists/large-v1"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run test && node scripts/manifest.mjs --check && node scripts/story-vectors.mjs --check && node scripts/check-bip39-wordlist.mjs && node scripts/check-video-effects.mjs && node scripts/generate-lexicons-v1.mjs --check && node scripts/check-large-story-vectors.mjs",
    "manifest:check": "npm run build && node scripts/manifest.mjs --check",
    "profile:short-hashes": "npm run build && node scripts/profile-short-hashes.mjs",
    "video-effects:check": "npm run build && node scripts/check-video-effects.mjs",
    "test:framerudiments": "python -m unittest discover -s tests/python -v",
    "lexicons:check": "node scripts/generate-lexicons-v1.mjs --check"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "license": "MIT",
  "bin": {
    "bytefables": "./bin/bytefables.mjs"
  }
}
